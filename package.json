{
  "name": "web2music",
  "version": "0.0.0",
  "private": true,
  "description": "Web2Music — mood-adaptive ambient music Chrome extension. Monorepo root: workspaces + shared Docker infra for Features A/B/D and the extension shell.",
  "workspaces": [
    "ui",
    "data-extraction",
    "mood-classification",
    "services/embed",
    "services/classify"
  ],
  "scripts": {
    "build": "node ui/build.mjs",
    "build:watch": "node ui/build.mjs --watch",
    "test": "npm run test -w data-extraction && npm run test -w mood-classification",
    "test:a": "npm run test -w data-extraction",
    "test:b": "npm run test -w mood-classification",
    "test:d": "pytest",
    "bench": "npm run bench -w data-extraction",
    "up": "docker compose -f docker/docker-compose.yml up -d",
    "down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
