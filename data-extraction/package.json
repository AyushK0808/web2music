{
  "name": "web2music-data-extraction",
  "version": "0.0.0",
  "private": true,
  "description": "Feature A content-script modules: text, embedding, and colour extraction.",
  "scripts": {
    "test": "node globals_test.js && node vectorStore_test.js && node pageData_test.js && node qdrant_test.js",
    "test:qdrant": "node qdrant_test.js",
    "qdrant:up": "docker compose -f ../docker/docker-compose.yml --profile research up -d qdrant",
    "qdrant:down": "docker compose -f ../docker/docker-compose.yml stop qdrant",
    "play": "node playground.js",
    "bench": "node benchmark/extractionCost.js",
    "bench:build-embedding": "esbuild benchmark/.embed-bundle-build/entry.mjs --bundle --format=iife --platform=browser --minify --outfile=benchmark/.embed-bundle-build/transformers-bundle.js --loader:.wasm=file --define:process.env.NODE_ENV='\"production\"'"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "puppeteer-core": "^25.4.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
