# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ── embed-service ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override the embedding model (must match Embeddingmodel.js openaiModel).
EMBED_MODEL=text-embedding-3-small

# Shared secret required in the `X-Service-Secret` header. Strongly recommended:
# without it, any local process that can reach the port can spend your OpenAI
# quota. Pass the same value as embeddingConfig.serviceSecret.
#   generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_SECRET=

# CORS origin allowed to call the service directly. Leave empty (the default) so
# no browser page origin can.
ALLOWED_ORIGIN=

# ── qdrant (vector database) ───────────────────────────────────────────────
# Optional API key. The port is published on 127.0.0.1 only, so this is defence
# in depth rather than the primary control. If set, pass the same value as
# createQdrantAdapter({ apiKey }).
QDRANT_API_KEY=

# Qdrant log level: TRACE | DEBUG | INFO | WARN | ERROR
QDRANT_LOG_LEVEL=INFO
