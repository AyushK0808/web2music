# Web2Music — root environment file. Copy to `.env` (gitignored) and fill in.
# Every variable actually read by the codebase is listed below; nothing here
# is speculative. Uncomment an override only if you need to change it from
# its working default.

# ── Compose profiles ─────────────────────────────────────────────────────
# cpu | gpu | research, comma-separated. `docker compose up` with neither
# cpu nor gpu set still brings up db + classify-service (Feature B's
# minimum viable stack); it just won't have an audio backend.
COMPOSE_PROFILES=cpu

# ── Required ──────────────────────────────────────────────────────────────

# Feature B tier-2 classification (classify-service, :8078). No fallback --
# without this, every page silently degrades to the "calm" mood.
# Get a free key at https://console.groq.com/keys (starts with "gsk_").
GROQ_API_KEY=gsk_your-key-here

# ── Optional: Feature B tier-1.5 zero-shot page-type classifier ───────────
# Runs facebook/bart-large-mnli via the HuggingFace Inference API, proxied by
# the same classify-service (POST /v1/zero-shot). Leave HF_API_TOKEN empty to
# keep the tier off entirely -- B1 then behaves exactly as it did before it
# existed (keyword heuristic, then the Groq LLM). See
# mood-classification/feature_b/b1_zeroShotCategory.js.
# Free read token: https://huggingface.co/settings/tokens
HF_API_TOKEN=
# Override only to evaluate a different MNLI checkpoint (e.g. a distilled one).
# ZERO_SHOT_MODEL=facebook/bart-large-mnli

# ── Feature D ─────────────────────────────────────────────────────────────

IS_PROD=false

# Baked into the audio_url handed back to the extension (see
# audio-generation/d5_cache_local.py, fallback.py) -- this is what the
# browser actually fetches from, not a connection string. Change this if
# Feature D moves off localhost (e.g. onto a GPU box on your LAN).
LOCAL_SERVER_URL=http://127.0.0.1:8000

# Required only when IS_PROD=true (Supabase storage/table instead of local
# Postgres + disk).
SUPABASE_URL=
SUPABASE_KEY=

# ── `research` profile only (Feature A: OpenAI embed proxy) ─────────────
# Not needed to run the extension itself -- it vendors a local embedding
# model. Only needed for corpus-scale VectorStore work or the §7
# privacy/utility ablation (embeddingConfig.backend: 'service').

OPENAI_API_KEY=

# Empty means any local process/webpage that can reach :8077 could spend
# your OpenAI quota. Strongly recommended once you set OPENAI_API_KEY.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_SECRET=

# ── Overrides (working defaults -- uncomment only to change) ─────────────

# EMBED_MODEL=text-embedding-3-small
# ALLOWED_ORIGIN=                       # empty is the secure default; no
#                                        # browser page origin may call the
#                                        # embed proxy directly
# QDRANT__SERVICE__API_KEY=             # read by both the qdrant container
#                                        # AND data-extraction/qdrant_test.js
#                                        # -- use this exact name, not
#                                        # QDRANT_API_KEY
# LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/audio_cache
