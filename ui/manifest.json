{
  "manifest_version": 3,
  "name": "Adaptive Audio",
  "version": "1.0",
  "description": "Generates ambient music based on webpage content",

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "offscreen",
    "idle",
    "scripting",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Adaptive Audio"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "vendor/Textextractor.js",
        "vendor/Colorextractor.js",
        "vendor/syllableCounter.js",
        "vendor/Readability.js",
        "vendor/behaviorTracker.js",
        "vendor/pageData.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}