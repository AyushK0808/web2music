# ─────────────────────────────────────────────────────────────────────────
# Web2Music — generalised .gitignore (covers all feature modules:
# JS/Node for A, B, C; Python/FastAPI for D; Docker; editors; OS cruft)
# ─────────────────────────────────────────────────────────────────────────

# ── Node / JavaScript ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
*.tsbuildinfo
.eslintcache

# Build / bundle output
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.vite/
coverage/
*.min.js.map

# ── Python (Feature D — FastAPI / MusicGen) ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
venv/
venv312/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
pip-log.txt

# ── Secrets / environment ──
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.json
credentials.json

# ── Docker ──
# (keep Dockerfile / docker-compose.yml tracked; ignore local overrides)
docker-compose.override.yml
*.env.local

# ── Model / media / generated artifacts ──
*.bin
*.pt
*.ckpt
*.safetensors
*.wav
*.mp3
*.flac
generated_audio/

# Feature D's generated cache -- real dir is hyphenated, not underscored;
# "audio_cache/" here never matched it and let generated clips get committed.
audio-generation/audio-cache/

# fallback_clips/*.ogg (Feature D's fallback clips) are intentionally
# tracked, not generated output -- deterministic reproducibility artifacts
# every error path in main.py depends on. Nothing above ignores *.ogg/*.mp3
# generically; don't reintroduce a blanket audio-extension rule here.

# Vendored embedding model + ONNX runtime for the extension (Phase 1) --
# committed on purpose so `git clone && npm run build` works without a
# separate download step. Scoped to ui/models/ so a stray *.onnx elsewhere
# (e.g. an experiment script's scratch output) is still ignored.
*.onnx
!ui/models/**/*.onnx

# ...but NOT the valhalla/distilbart-mnli-12-1 export. It is the opt-in
# alternative checkpoint documented in ui/models/README.md, and its
# onnx/model_quantized.onnx is 215 MB -- past GitHub's hard 100 MB per-file
# push limit, so committing it would make every push to origin fail outright.
# Distributed via the Hugging Face Hub instead; see ui/models/README.md.
ui/models/valhalla/

# Hugging Face's on-disk download cache, written by the local zero-shot
# backend and by mood-classification/experiments/localZeroShot.js on first
# run. Pure re-downloadable cache (118 MB of it), not a vendored artifact.
.model-cache/

# ── Editors / IDEs ──
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Logs / temp ──
*.log
logs/
tmp/
temp/
*.tmp
.claude/
*.crx

# Feature A benchmark output (regenerate with `npm run bench`)
data-extraction/benchmark/extraction-cost-results.json
